FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    HOST=0.0.0.0 \
    GOOGLE_GENAI_USE_VERTEXAI=TRUE \
    GOOGLE_API_USE_MTLS_ENDPOINT=never \
    GOOGLE_API_USE_CLIENT_CERTIFICATE=false

WORKDIR /app

# Install curl for container health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy package configuration and metadata
COPY pyproject.toml README.md LICENSE NOTICE /app/
COPY src/ /app/src/

# Install the package and dependencies
RUN pip install --no-cache-dir .

# Copy the agent application code
COPY compute_agent/ /app/compute_agent/

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "compute_agent.app:app", "--host", "0.0.0.0", "--port", "8080"]
