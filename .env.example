# ==============================================================================
# Model & Google Cloud Configuration
# ==============================================================================
# Option 1: Google AI Studio API Key (Local dev)
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Vertex AI on Google Cloud (Production)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
AGENTIC_COMPUTE_MODEL=gemini-2.5-flash

# ==============================================================================
# MCP Runtime Configuration
# ==============================================================================
# Runtime backend: "simulator" (default) or "slurm"
COMPUTE_RUNTIME=simulator

# Remote MCP Server URL (used by Agent to connect to Cloud Run MCP service over SSE)
# Leave unset or empty for local stdio subprocess
# MCP_SERVER_URL=https://agentic-compute-mcp-xyz-uc.a.run.app

# Server transport for MCP service: "stdio" (local default) or "sse" (Cloud Run)
MCP_TRANSPORT=stdio

# HTTP Server settings
PORT=8080
HOST=0.0.0.0

# ==============================================================================
# Slurm Backend Configuration (when COMPUTE_RUNTIME=slurm)
# ==============================================================================
# Default points to Dubai cluster controller on internal VPC
SLURM_REST_URL=http://10.0.0.4:6842/slurm/v0.0.41
SLURM_USER=slurm
SLURM_JWT_TOKEN=
SLURM_JOB_ID=1
SLURM_TOTAL_CPU=128
CPU_COST_PER_HOUR_EUR=0.05
DEADLINE_MINUTES=25.0
